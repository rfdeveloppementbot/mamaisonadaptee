---
permalink: /index.html
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.titre_page }}</title>
<meta name="description" content="{{ site.description_page }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  /* ============================================================
     COULEURS ISSUES DE LA CHARTE GRAPHIQUE OFFICIELLE (2021)
       Rose fuchsia  #E6007E   (CMJN 0/100/0/0)
       Violet        #622977   (CMJN 76/98/13/4)
       Gris foncé    #5D5D5D   |  Gris clair  #A3A2A2
       Dégradé autorisé : violet -> rose, à 0°, 45° ou 90°
       Typographie : Acumin Pro en priorité (Adobe Fonts) ;
                     à défaut Montserrat (utilisée ici).
     >>> RESTE À FAIRE : insérer le LOGO OFFICIEL (fichier vectoriel).
         Le logo ne doit JAMAIS être redessiné, ni le texte utilisé
         sans la pastille. Hauteur mini 7 mm, zone de sécurité = 50 %
         de la taille de la pastille.
     ============================================================ */
  :root{
    --brand:#E6007E;          /* rose fuchsia officiel */
    --brand-2:#C80070;        /* rose survol */
    --brand-deep:#A8005C;     /* rose foncé : texte/liens, contraste AA */
    --violet:#622977;         /* violet officiel */
    --violet-2:#4E1F5F;       /* violet foncé (survol/fond) */
    --ink:#3A3A3A;            /* texte principal, dérivé du gris charte */
    --ink-soft:#5D5D5D;       /* gris foncé officiel */
    --grey-light:#A3A2A2;     /* gris clair officiel */
    --cream:#FFFFFF;          /* fond de page blanc */
    --sand:#F6F6F6;           /* panneaux doux, gris neutre */
    --line:#E4E4E4;           /* filets */
    --radius:18px;
    --maxw:1140px;
    --shadow:0 18px 44px -26px rgba(58,58,58,.45);
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{margin:0;background:var(--cream);color:var(--ink);
    font-family:'Montserrat',system-ui,sans-serif;font-size:18px;line-height:1.65;-webkit-font-smoothing:antialiased}
  h1,h2,h3{font-family:'Montserrat',system-ui,sans-serif;font-weight:600;line-height:1.14;margin:0;letter-spacing:-.01em}
  p{margin:0 0 1em}
  a{color:var(--brand-deep)}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}

  .skip{position:absolute;left:-999px;top:0;background:var(--ink);color:#fff;padding:14px 20px;border-radius:0 0 12px 0;z-index:200}
  .skip:focus{left:0}
  a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,.btn:focus-visible{
    outline:3px solid var(--brand-deep);outline-offset:3px;border-radius:6px}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:.55em;font-family:'Montserrat',sans-serif;
    font-weight:700;font-size:1.02rem;text-decoration:none;border:none;cursor:pointer;
    padding:15px 26px;min-height:54px;border-radius:999px;
    transition:transform .15s ease,box-shadow .15s ease,background .15s ease}
  @media (prefers-reduced-motion:reduce){.btn{transition:none}}
  .btn-primary{background:var(--brand);color:#fff;box-shadow:0 12px 26px -14px rgba(229,0,126,.85)}
  .btn-primary:hover{background:var(--brand-2);transform:translateY(-2px)}
  .btn-ghost{background:#fff;color:var(--brand-deep);border:2px solid var(--brand)}
  .btn-ghost:hover{background:var(--sand)}
  .ico{line-height:1;display:inline-flex;align-items:center}

  /* En-tête */
  header.site{position:sticky;top:0;z-index:100;background:rgba(255,248,244,.94);
    backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  .site .bar{display:flex;align-items:center;justify-content:space-between;gap:16px;height:78px}
  .logo{display:flex;align-items:center;gap:16px;text-decoration:none;color:var(--ink)}
  /* LOGO OFFICIEL — hauteur mini 7 mm à l'impression ; les marges tiennent lieu
     de zone de sécurité (50 % de la taille de la pastille). Ne pas redessiner. */
  /* Icônes vectorielles (remplacent les emojis, rendu identique partout) */
  .sprite{position:absolute;width:0;height:0;overflow:hidden}
  .i{width:1em;height:1em;flex:none;stroke:currentColor;fill:none;
     stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  /* Logo intégré : les couleurs se pilotent par variables */
  .mark-img{height:34px;width:180px;display:block}
  footer.site .mark-img{--lg-dark:#FFFFFF;--lg-light:#E4D6EA}
  .agency{font-family:'Montserrat',sans-serif;font-size:.82rem;font-weight:500;color:var(--ink-soft);
    border-left:1px solid var(--line);padding-left:16px;white-space:nowrap}
  @media (max-width:560px){.agency{display:none}}
  .head-cta{display:flex;align-items:center;gap:12px}
  .phone-head{display:inline-flex;align-items:center;gap:.5em;font-weight:700;color:var(--brand-deep);text-decoration:none;font-size:1.1rem}
  @media (max-width:820px){.phone-head span.txt{display:none}.head-cta .btn-ghost{display:none}}

  /* HERO */
  .hero{position:relative;padding:72px 0 56px}
  .hero .grid{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}
  .eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--brand);flex:none}
  .eyebrow{display:inline-flex;align-items:center;gap:.5em;font-weight:700;letter-spacing:.05em;text-transform:uppercase;
    font-size:.8rem;color:var(--brand-deep);background:#fff;border:1px solid var(--line);padding:8px 16px;border-radius:999px;margin-bottom:22px}
  .hero h1{font-size:clamp(2.3rem,4.8vw,3.6rem)}
  .hero h1 em{font-style:normal;color:var(--brand-deep)}
  .hero .lead{font-size:1.2rem;color:var(--ink-soft);max-width:36ch;margin:20px 0 30px}
  .hero .actions{display:flex;flex-wrap:wrap;gap:14px}
  .hero .reassure{margin-top:26px;display:flex;flex-wrap:wrap;gap:14px 26px;font-size:.96rem;color:var(--ink-soft)}
  .hero .reassure span{display:inline-flex;align-items:center;gap:.5em}
  .hero .reassure .ico{color:var(--brand-deep);font-size:1.05rem;display:flex}
  .hero-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
  .hero-card .ba{display:grid;grid-template-columns:1fr 1fr}
  .hero-card figure{margin:0;position:relative;aspect-ratio:4/5;display:grid;place-items:center;
    background:var(--sand);color:var(--ink-soft);text-align:center;padding:18px}
  .hero-card figure:first-child{background:#ECECEC}
  .hero-card .tag{position:absolute;top:12px;left:12px;background:rgba(42,33,28,.82);color:#fff;font-size:.72rem;
    font-weight:700;letter-spacing:.05em;padding:5px 12px;border-radius:999px;text-transform:uppercase}
  .hero-card .cap{padding:15px 20px;border-top:1px solid var(--line);font-size:.9rem;color:var(--ink-soft)}
  .ph{font-size:.84rem;opacity:.85;line-height:1.4}

  /* Bloc "Décrivez-nous votre projet" (signature franchiseur) */
  .project{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .project .wrap{padding:40px 24px}
  .project h2{font-size:clamp(1.5rem,2.6vw,2rem);text-align:center;margin-bottom:8px}
  .project p.sub{text-align:center;color:var(--ink-soft);margin:0 auto 28px;max-width:50ch}
  .choices{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}
  .choice{display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center;text-decoration:none;
    color:var(--ink);background:var(--cream);border:1px solid var(--line);border-radius:16px;padding:22px 14px;
    font-weight:600;font-size:.98rem;transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease}
  @media (prefers-reduced-motion:reduce){.choice{transition:none}}
  .choice:hover{transform:translateY(-3px);border-color:var(--brand);box-shadow:var(--shadow)}
  .choice .pic{width:52px;height:52px;border-radius:50%;background:#fff;border:1px solid var(--line);
    display:grid;place-items:center;font-size:1.55rem;color:var(--brand)}
  @media (max-width:900px){.choices{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:480px){.choices{grid-template-columns:1fr}}

  /* Bandeau aides */
  .aid{background:linear-gradient(45deg,var(--violet),var(--brand))}
  .aid .wrap{padding:34px 24px;display:flex;flex-wrap:wrap;align-items:center;gap:22px 40px;justify-content:space-between}
  .aid .left{display:flex;align-items:center;gap:24px;flex-wrap:wrap}
  .aid .pa{background:#fff;border-radius:16px;padding:14px 18px;font-weight:700;color:var(--violet);
    font-family:'Montserrat',sans-serif;text-align:center;line-height:1.1}
  .aid .pa small{display:block;font-size:.72rem;font-weight:600;color:var(--ink-soft);letter-spacing:.04em;text-transform:uppercase}
  .aid .pa b{font-size:1.9rem;display:block;margin-top:2px}
  .aid .copy{max-width:46ch;color:#fff}
  .aid .copy b{font-size:1.2rem;display:block;margin-bottom:4px;font-family:'Montserrat',sans-serif}
  .aid .copy p{margin:0;color:rgba(255,255,255,.92)}
  .aid .btn{background:#fff;color:var(--violet);white-space:nowrap}
  .aid .btn:hover{background:var(--sand);transform:translateY(-2px)}

  /* Sections */
  section{padding:78px 0;position:relative}
  .sec-head{max-width:62ch;margin-bottom:44px}
  .sec-head.center{margin-inline:auto;text-align:center}
  .kicker{color:var(--brand-deep);font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:.8rem;margin-bottom:12px}
  .sec-head h2{font-size:clamp(1.8rem,3.3vw,2.6rem)}
  .sec-head p{font-size:1.1rem;color:var(--ink-soft);margin-top:14px}

  /* Solutions */
  .solutions{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
  .sol{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:30px;
    transition:transform .18s ease,box-shadow .18s ease}
  @media (prefers-reduced-motion:reduce){.sol{transition:none}}
  .sol:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
  .sol .ic{width:60px;height:60px;border-radius:14px;background:var(--sand);display:grid;place-items:center;font-size:2.1rem;margin-bottom:18px;color:var(--brand)}
  .sol h3{font-size:1.35rem;margin-bottom:8px}
  .sol p{color:var(--ink-soft);margin:0 0 12px}
  .sol ul{margin:0;padding-left:1.1em;color:var(--ink-soft);font-size:.96rem}
  .sol li{margin-bottom:4px}

  /* Réalisations */
  .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .real{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;
    transition:transform .18s ease,box-shadow .18s ease}
  @media (prefers-reduced-motion:reduce){.real{transition:none}}
  .real:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
  .real .img{position:relative;aspect-ratio:4/3;background:var(--sand);display:grid;place-items:center;color:var(--ink-soft);text-align:center;padding:16px}
  .real .img .tag{position:absolute;top:10px;left:10px;background:var(--brand);color:#fff;font-size:.7rem;font-weight:800;padding:5px 11px;border-radius:999px}
  .real .img .days{position:absolute;bottom:10px;right:10px;background:rgba(42,33,28,.82);color:#fff;font-size:.74rem;font-weight:700;padding:5px 11px;border-radius:999px}
  .real .body{padding:18px 20px}
  .real .loc{font-size:.78rem;color:var(--brand-deep);font-weight:700;letter-spacing:.04em;text-transform:uppercase}
  .real h3{font-size:1.08rem;margin:6px 0 0;line-height:1.3}
  .gallery-note{margin-top:18px;font-size:.94rem;color:var(--ink-soft)}

  /* Étapes (5) */
  .steps{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;counter-reset:step}
  .step{background:#fff;border:1px solid var(--line);border-radius:16px;padding:24px 20px;position:relative}
  .step .n{counter-increment:step;font-family:'Montserrat',sans-serif;font-weight:700;font-size:1.2rem;color:#fff;
    width:44px;height:44px;border-radius:50%;background:var(--brand);display:grid;place-items:center;margin-bottom:16px}
  .step .n::before{content:counter(step)}
  .step h3{font-size:1.08rem;margin-bottom:8px;line-height:1.25}
  .step p{color:var(--ink-soft);margin:0;font-size:.93rem}
  @media (max-width:1000px){.steps{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:520px){.steps{grid-template-columns:1fr}}

  /* Atouts réseau */
  .atouts{background:var(--violet);color:#EFE6F2}
  .atouts .head-row{display:flex;align-items:baseline;gap:18px;flex-wrap:wrap;margin-bottom:34px}
  .atouts .big{font-family:'Montserrat',sans-serif;font-weight:700;font-size:clamp(1.9rem,4vw,2.8rem);color:var(--brand);white-space:nowrap}
  .atouts h2{font-size:clamp(1.5rem,2.6vw,2rem);color:#fff}
  .atouts .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .atout{display:flex;gap:14px;align-items:flex-start;background:var(--violet-2);border:1px solid #74408A;border-radius:14px;padding:20px}
  .atout .ic{color:var(--brand);font-size:1.5rem;line-height:1;display:flex}
  .atout b{display:block;color:#fff;margin-bottom:3px;font-family:'Montserrat',sans-serif;font-weight:600}
  .atout span{color:#D5C4DC;font-size:.94rem}
  @media (max-width:820px){.atouts .grid{grid-template-columns:1fr}}


  /* Zone d'intervention */
  .towns{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:10px}
  .towns li{background:var(--sand);border:1px solid var(--line);border-radius:999px;
    padding:9px 18px;font-size:.96rem;color:var(--ink)}
  .towns li.more{background:none;border-style:dashed;color:var(--ink-soft)}
  .zone-note{margin-top:20px;font-size:.96rem;color:var(--ink-soft)}

  /* Avis */
  .reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .rev{background:#fff;border:1px solid var(--line);border-radius:16px;padding:26px}
  .rev .stars{color:#F5A623;font-size:1.05rem;letter-spacing:2px;margin-bottom:10px}
  .rev p{font-style:italic;color:var(--ink);margin:0 0 12px}
  .rev .who{font-weight:700;font-size:.92rem;color:var(--ink-soft)}
  @media (max-width:820px){.reviews{grid-template-columns:1fr}}
  .reviews-note{margin-top:18px;font-size:.94rem;color:var(--ink-soft)}

  /* Contact */
  .contact{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
  .big-phone{background:var(--brand);color:#fff;border-radius:var(--radius);padding:32px;margin-bottom:22px}
  .big-phone small{text-transform:uppercase;letter-spacing:.06em;font-size:.78rem;opacity:.85}
  .big-phone a{display:block;color:#fff;text-decoration:none;font-family:'Montserrat',sans-serif;font-weight:700;font-size:2rem;margin-top:6px}
  .cinfo{display:grid;gap:14px;font-size:1rem}
  .cinfo div{display:flex;gap:.7em;align-items:flex-start}
  .cinfo .ico{color:var(--brand-deep);font-size:1.15rem;margin-top:2px;display:flex}
  .form{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:30px;box-shadow:var(--shadow)}
  .form label{display:block;font-weight:700;margin:0 0 6px;font-size:.94rem}
  .form .field{margin-bottom:18px}
  .form input,.form textarea,.form select{width:100%;font-family:inherit;font-size:1rem;padding:13px 15px;
    border:2px solid var(--line);border-radius:12px;background:var(--cream);color:var(--ink)}
  .form input:focus,.form textarea:focus,.form select:focus{border-color:var(--brand);outline:none}
  .form textarea{min-height:110px;resize:vertical}
  .form .btn{width:100%}
  .form .legal{font-size:.8rem;color:var(--ink-soft);margin:14px 0 0}

  /* Footer */
  footer.site{background:var(--violet-2);color:#D5C4DC;padding:54px 0 28px;font-size:.95rem}
  footer.site .top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:30px;margin-bottom:32px}
  footer.site .agency{color:#D5C4DC;border-left-color:#74408A}
  footer.site a{color:#FF7FC0}
  footer.site .cols{display:flex;gap:48px;flex-wrap:wrap}
  footer.site h4{font-family:'Montserrat',sans-serif;font-size:.82rem;letter-spacing:.05em;text-transform:uppercase;color:#fff;margin:0 0 12px}
  footer.site ul{list-style:none;padding:0;margin:0;display:grid;gap:8px}
  footer.site .legal-line{border-top:1px solid #74408A;padding-top:20px;color:#B7A2BF;font-size:.8rem;line-height:1.6}

  .reveal{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}
  .reveal.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}

  @media (max-width:900px){
    .hero .grid,.contact{grid-template-columns:1fr;gap:34px}
    .solutions,.gallery{grid-template-columns:1fr}
    section{padding:58px 0}.hero{padding:48px 0}
  }
</style>
</head>
<body>
