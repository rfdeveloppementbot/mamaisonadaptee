<header class="site">
  <div class="wrap bar">
    <a href="#" class="logo" aria-label="Dom&amp;Vie {{ site.agence }}, accueil">
      <svg class="mark-img" role="img" aria-label="Dom&amp;Vie"><use href="#logo-domvie"/></svg>
      <span class="agency">{{ site.agence }}</span>
    </a>
    <nav class="head-cta" aria-label="Actions principales">
      <a class="phone-head" href="tel:{{ site.telephone_lien }}"><span class="ico" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-tel"/></svg></span><span class="txt">{{ site.telephone }}</span></a>
      <a class="btn btn-ghost" href="#contact">Votre projet</a>
    </nav>
  </div>
</header>

<main id="contenu">

  <section class="hero" aria-labelledby="h-title">
    <div class="wrap grid">
      <div class="reveal">
        <span class="eyebrow"><span class="dot" aria-hidden="true"></span> {{ site.hero_surtitre }}</span>
        <h1 id="h-title">{{ site.hero_titre }} <em>{{ site.hero_titre_accent }}</em>.</h1>
        <p class="lead">{{ site.hero_texte }}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#contact"><span class="ico" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-crayon"/></svg></span> Vous avez un projet ?</a>
          <a class="btn btn-ghost" href="tel:{{ site.telephone_lien }}"><span class="ico" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-tel"/></svg></span> Nous appeler</a>
        </div>
        <div class="reassure">
          {%- for gage in site.hero_gages %}
          <span><span class="ico" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-check"/></svg></span> {{ gage }}</span>
          {%- endfor %}
        </div>
      </div>
      <div class="hero-card reveal">
        <div class="ba">
          <figure>
            <span class="tag">Avant</span>
            {%- if site.hero_image_avant %}<img src="{{ site.hero_image_avant }}" alt="Salle de bain avant travaux">
            {%- else %}<span class="ph">Photo « avant »</span>{% endif %}
          </figure>
          <figure>
            <span class="tag" style="background:var(--brand-deep)">Après</span>
            {%- if site.hero_image_apres %}<img src="{{ site.hero_image_apres }}" alt="Douche sécurisée après travaux">
            {%- else %}<span class="ph">Photo « après »</span>{% endif %}
          </figure>
        </div>
        <div class="cap">{{ site.hero_legende }}</div>
      </div>
    </div>
  </section>

  <div class="project" aria-labelledby="proj-title">
    <div class="wrap">
      <h2 id="proj-title">{{ site.projet_titre }}</h2>
      <p class="sub">{{ site.projet_sous_titre }}</p>
      <div class="choices">
        {%- for c in site.projet_choix %}
        <a class="choice" href="#contact"><span class="pic" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-{{ c.icone }}"/></svg></span>{{ c.libelle }}</a>
        {%- endfor %}
      </div>
    </div>
  </div>

  <div class="aid" aria-labelledby="aid-title">
    <div class="wrap">
      <div class="left">
        <div class="pa"><small>MaPrimeAdapt'</small><b>{{ site.aide_montant }}</b></div>
        <div class="copy">
          <b id="aid-title">{{ site.aide_titre }}</b>
          <p>{{ site.aide_texte }}</p>
        </div>
      </div>
      <a class="btn" href="#contact">Simuler mon aide</a>
    </div>
  </div>

  <section aria-labelledby="sol-title">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="kicker">Nos solutions</div>
        <h2 id="sol-title">{{ site.solutions_titre }}</h2>
        <p>{{ site.solutions_texte }}</p>
      </div>
      <div class="solutions">
        {%- for s in site.solutions %}
        <article class="sol reveal">
          <div class="ic" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-{{ s.icone }}"/></svg></div>
          <h3>{{ s.titre }}</h3>
          <p>{{ s.texte }}</p>
          <ul>{% for pt in s.points %}<li>{{ pt }}</li>{% endfor %}</ul>
        </article>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section style="background:var(--sand)" aria-labelledby="real-title">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="kicker">Nos réalisations</div>
        <h2 id="real-title">{{ site.realisations_titre }}</h2>
        <p>{{ site.realisations_texte }}</p>
      </div>
      <div class="gallery">
        {%- for r in site.realisations %}
        <article class="real reveal">
          <div class="img">
            <span class="tag">Avant / Après</span>
            <span class="days">{{ r.duree }}</span>
            {%- if r.image %}<img src="{{ r.image }}" alt="{{ r.titre }}, à {{ r.commune }}">
            {%- else %}<span class="ph">Photo à insérer</span>{% endif %}
          </div>
          <div class="body"><span class="loc">{{ r.commune }}</span><h3>{{ r.titre }}</h3></div>
        </article>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section aria-labelledby="step-title">
    <div class="wrap">
      <div class="sec-head center reveal">
        <div class="kicker">Votre projet</div>
        <h2 id="step-title">{{ site.etapes_titre }}</h2>
      </div>
      <div class="steps">
        {%- for e in site.etapes %}
        <article class="step reveal"><div class="n" aria-hidden="true"></div><h3>{{ e.titre }}</h3><p>{{ e.texte }}</p></article>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section class="atouts" aria-labelledby="at-title">
    <div class="wrap">
      <div class="head-row reveal">
        <span class="big">{{ site.atouts_gros_mot }}</span>
        <h2 id="at-title">{{ site.atouts_titre }}</h2>
      </div>
      <div class="grid">
        {%- for a in site.atouts %}
        <div class="atout reveal"><span class="ic" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-{{ a.icone }}"/></svg></span><div><b>{{ a.titre }}</b><span>{{ a.texte }}</span></div></div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section aria-labelledby="zone-title">
    <div class="wrap">
      <div class="sec-head reveal" style="margin-bottom:22px">
        <div class="kicker">Zone d'intervention</div>
        <h2 id="zone-title">{{ site.zone_titre }}</h2>
        <p>{{ site.zone_texte }}</p>
      </div>
      <ul class="towns reveal" aria-label="Communes desservies">
        {%- for c in site.communes %}<li>{{ c }}</li>{% endfor %}
        <li class="more">… et les communes alentour</li>
      </ul>
      <p class="zone-note">{{ site.zone_note }}</p>
    </div>
  </section>

  <section aria-labelledby="rev-title">
    <div class="wrap">
      <div class="sec-head center reveal">
        <div class="kicker">Avis clients</div>
        <h2 id="rev-title">{{ site.avis_titre }}</h2>
      </div>
      <div class="reviews">
        {%- for a in site.avis %}
        <article class="rev reveal">
          <div class="stars" aria-label="{{ a.note }} sur 5">{% for i in range(0, a.note) %}★{% endfor %}</div>
          <p>« {{ a.texte }} »</p>
          <div class="who">— {{ a.auteur }}, {{ a.commune }}</div>
        </article>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section id="contact" style="background:var(--sand)" aria-labelledby="contact-title">
    <div class="wrap contact">
      <div class="reveal">
        <div class="sec-head" style="margin-bottom:22px">
          <div class="kicker">Contact</div>
          <h2 id="contact-title">{{ site.contact_titre }}</h2>
          <p>{{ site.contact_texte }}</p>
        </div>
        <div class="big-phone">
          <small>Appelez directement</small>
          <a href="tel:{{ site.telephone_lien }}">{{ site.telephone }}</a>
        </div>
        <div class="cinfo">
          <div><span class="ico" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-mail"/></svg></span><span><a href="mailto:{{ site.email }}">{{ site.email }}</a></span></div>
          <div><span class="ico" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-globe"/></svg></span><span>{{ site.site_web }}</span></div>
          <div><span class="ico" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-lieu"/></svg></span><span>{{ site.adresse }}</span></div>
          <div><span class="ico" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-horloge"/></svg></span><span>{{ site.horaires }}</span></div>
        </div>
      </div>

      <div class="form reveal">
        <form name="devis" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="devis">
          <p hidden><label>Ne pas remplir : <input name="bot-field"></label></p>
          <div class="field"><label for="nom">Votre nom</label><input id="nom" name="nom" type="text" autocomplete="name" required></div>
          <div class="field"><label for="tel">Téléphone</label><input id="tel" name="tel" type="tel" autocomplete="tel" required></div>
          <div class="field"><label for="projet">Votre projet</label>
            <select id="projet" name="projet">
              {%- for c in site.projet_choix %}<option>{{ c.libelle }}</option>{% endfor %}
              <option>Autre / je ne sais pas encore</option>
            </select>
          </div>
          <div class="field"><label for="msg">Précisions (facultatif)</label><textarea id="msg" name="msg" placeholder="Ex. : baignoire à remplacer par une douche sécurisée"></textarea></div>
          <button class="btn btn-primary" type="submit"><span class="ico" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-crayon"/></svg></span> Envoyer ma demande</button>
          <p class="legal">{{ site.formulaire_mention }}</p>
        </form>
      </div>
    </div>
  </section>
</main>

<footer class="site">
  <div class="wrap">
    <div class="top">
      <a href="#" class="logo" aria-label="Dom&amp;Vie {{ site.agence }}">
        <svg class="mark-img" role="img" aria-label="Dom&amp;Vie"><use href="#logo-domvie"/></svg>
        <span class="agency">{{ site.agence }}</span>
      </a>
      <div class="cols">
        <div><h4>Solutions</h4><ul>{% for s in site.solutions %}<li>{{ s.titre }}</li>{% endfor %}</ul></div>
        <div><h4>Aides</h4><ul><li>MaPrimeAdapt'</li><li>Autres financements</li><li>Accompagnement dossier</li></ul></div>
        <div><h4>Contact</h4><ul><li><a href="tel:{{ site.telephone_lien }}">{{ site.telephone }}</a></li><li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li><li>{{ site.site_web }}</li><li>{{ site.adresse }}</li></ul></div>
      </div>
    </div>
    <p class="legal-line">
      {{ site.site_web }} — Dom&amp;Vie {{ site.agence }} · {{ site.gerant }}, micro-entrepreneur · SIREN {{ site.siren }} · Membre du réseau Dom&amp;Vie.<br>
      <a href="/mentions-legales/">Mentions légales</a> · <a href="/confidentialite/">Politique de confidentialité</a>
    </p>
  </div>
</footer>

<script>
  (function(){
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = document.querySelectorAll('.reveal');
    if(reduce || !('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in')});return;}
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);}});
    },{threshold:.12});
    els.forEach(function(e){io.observe(e)});
  })();
</script>
</body>
</html>
